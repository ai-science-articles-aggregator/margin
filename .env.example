# Backend для браузера (client-side axios). В dev можно не задавать —
# vite-прокси сам шлёт на http://localhost:8000; задай, если backend на др. хосте.
VITE_API_URL=http://localhost:8000

# Backend для SSR (server-side fetch SvelteKit). Адрес выбирается автоматически:
#   dev → http://localhost:8000, прод → http://backend:8000 (docker-сеть citadel).
# Раскомментируй ТОЛЬКО для нестандартной топологии (backend на другом адресе):
# API_INTERNAL_URL=http://backend.internal:8000
